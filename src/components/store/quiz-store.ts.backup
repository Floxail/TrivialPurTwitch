import { create } from 'zustand';
import { persist } from 'zustand/middleware';

const localStorageKey: string = 'quiz_questions_storage_v1';

// Catégories Trivial Pursuit standard
export enum TrivialCategory {
  Geography = 0,      // Bleu
  Entertainment = 1,  // Rose
  History = 2,        // Jaune
  Arts = 3,          // Marron/Orange
  Science = 4,       // Vert
  Sports = 5         // Orange
}

export const categoryNames: Record<TrivialCategory, string> = {
  [TrivialCategory.Geography]: '▲ Bleu',
  [TrivialCategory.Entertainment]: '▲ Rose',
  [TrivialCategory.History]: '▲ Jaune',
  [TrivialCategory.Arts]: '▲ Marron',
  [TrivialCategory.Science]: '▲ Vert',
  [TrivialCategory.Sports]: '▲ Orange',
};

export const categoryColors: Record<TrivialCategory, string> = {
  [TrivialCategory.Geography]: '#4A90E2',      // Bleu
  [TrivialCategory.Entertainment]: '#E91E63',  // Rose
  [TrivialCategory.History]: '#e0aa07ff',        // Jaune
  [TrivialCategory.Arts]: '#412803ff',           // Marron
  [TrivialCategory.Science]: '#4CAF50',        // Vert
  [TrivialCategory.Sports]: '#FF5722',         // Rouge-Orange
};

export type Question = {
  id: string;
  category: TrivialCategory;
  question: string;
  answer: string;
  alternativeAnswers?: string[]; // Réponses alternatives acceptées
  trivialBox: string; // Nom de la boîte Trivial Pursuit
  difficulty?: 'easy' | 'medium' | 'hard';
};

export type QuizCard = {
  questions: Question[]; // 6 questions, une par catégorie
  trivialBox: string;
};

export type ActiveQuiz = {
  card: QuizCard;
  currentQuestionIndex: number;
  startTime: number;
  questionStartTime: number;
  answers: Map<number, string[]>; // Index de question -> liste des joueurs ayant répondu
};

export class QuizData {
  questions: Question[] = [];
  trivialBoxes: string[] = [];
  activeQuiz: ActiveQuiz | null = null;
  completedQuizzes: number = 0;
}

type Actions = {
  backup: () => void;
  clear: () => void;
  addQuestion: (question: Question) => void;
  updateQuestion: (questionId: string, updates: Partial<Question>) => void;
  deleteQuestion: (questionId: string) => void;
  addTrivialBox: (boxName: string) => void;
  removeTrivialBox: (boxName: string) => void;
  getTrivialBoxes: () => string[];
  getQuestionsByBox: (boxName: string) => Question[];
  generateQuizCard: (boxName: string) => QuizCard | null;
  startQuiz: (card: QuizCard) => void;
  nextQuestion: () => boolean;
  endQuiz: () => void;
  recordAnswer: (questionIndex: number, playerNick: string) => void;
};

// Restore persisted state
const plain: QuizData = JSON.parse(localStorage.getItem(localStorageKey) || '{}');
const restoredState: QuizData = {
  questions: plain.questions || [],
  trivialBoxes: plain.trivialBoxes || [],
  activeQuiz: null, // On ne restore pas le quiz actif
  completedQuizzes: plain.completedQuizzes || 0,
};

export const useQuizStore = create<QuizData & Actions>()(
  persist(
    (set, get) => ({
      questions: restoredState.questions,
      trivialBoxes: restoredState.trivialBoxes,
      activeQuiz: restoredState.activeQuiz,
      completedQuizzes: restoredState.completedQuizzes,

      backup: () => {
        const current = get();
        const backedUp = {
          questions: current.questions,
          trivialBoxes: current.trivialBoxes,
          completedQuizzes: current.completedQuizzes,
        };
        localStorage.setItem(localStorageKey, JSON.stringify(backedUp));
      },

      clear: () => {
        localStorage.removeItem(localStorageKey);
        set({ 
          questions: [], 
          trivialBoxes: [], 
          activeQuiz: null, 
          completedQuizzes: 0 
        });
      },

      addQuestion: (question: Question) => {
        set((state) => ({
          questions: [...state.questions, question],
        }));
        get().backup();
      },

      updateQuestion: (questionId: string, updates: Partial<Question>) => {
        set((state) => ({
          questions: state.questions.map((q) =>
            q.id === questionId ? { ...q, ...updates } : q
          ),
        }));
        get().backup();
      },

      deleteQuestion: (questionId: string) => {
        set((state) => ({
          questions: state.questions.filter((q) => q.id !== questionId),
        }));
        get().backup();
      },

      addTrivialBox: (boxName: string) => {
        set((state) => {
          if (!state.trivialBoxes.includes(boxName)) {
            return { trivialBoxes: [...state.trivialBoxes, boxName] };
          }
          return state;
        });
        get().backup();
      },

      removeTrivialBox: (boxName: string) => {
        set((state) => ({
          trivialBoxes: state.trivialBoxes.filter((b) => b !== boxName),
        }));
        get().backup();
      },

      getTrivialBoxes: () => {
        return get().trivialBoxes;
      },

      getQuestionsByBox: (boxName: string) => {
        return get().questions.filter((q) => q.trivialBox === boxName);
      },

      generateQuizCard: (boxName: string) => {
        const allQuestions = get().getQuestionsByBox(boxName);
        
        // Vérifier qu'on a au moins une question par catégorie
        const questionsByCategory: Record<TrivialCategory, Question[]> = {
          [TrivialCategory.Geography]: [],
          [TrivialCategory.Entertainment]: [],
          [TrivialCategory.History]: [],
          [TrivialCategory.Arts]: [],
          [TrivialCategory.Science]: [],
          [TrivialCategory.Sports]: [],
        };

        allQuestions.forEach((q) => {
          questionsByCategory[q.category].push(q);
        });

        // Sélectionner une question aléatoire par catégorie
        const card: QuizCard = {
          questions: [],
          trivialBox: boxName,
        };

        for (let category = 0; category < 6; category++) {
          const categoryQuestions = questionsByCategory[category as TrivialCategory];
          if (categoryQuestions.length === 0) {
            console.error(`Pas assez de questions pour la catégorie ${categoryNames[category as TrivialCategory]}`);
            return null;
          }
          const randomQuestion = categoryQuestions[Math.floor(Math.random() * categoryQuestions.length)];
          card.questions.push(randomQuestion);
        }

        return card;
      },

      startQuiz: (card: QuizCard) => {
        set({
          activeQuiz: {
            card,
            currentQuestionIndex: 0,
            startTime: Date.now(),
            questionStartTime: Date.now(),
            answers: new Map(),
          },
        });
      },

      nextQuestion: () => {
        const current = get().activeQuiz;
        if (!current) return false;

        const nextIndex = current.currentQuestionIndex + 1;
        if (nextIndex >= current.card.questions.length) {
          return false; // Quiz terminé
        }

        set({
          activeQuiz: {
            ...current,
            currentQuestionIndex: nextIndex,
            questionStartTime: Date.now(),
          },
        });
        return true;
      },

      endQuiz: () => {
        set((state) => ({
          activeQuiz: null,
          completedQuizzes: state.completedQuizzes + 1,
        }));
        get().backup();
      },

      recordAnswer: (questionIndex: number, playerNick: string) => {
        const current = get().activeQuiz;
        if (!current) return;

        const answers = new Map(current.answers);
        const questionAnswers = answers.get(questionIndex) || [];
        
        if (!questionAnswers.includes(playerNick)) {
          questionAnswers.push(playerNick);
          answers.set(questionIndex, questionAnswers);

          set({
            activeQuiz: {
              ...current,
              answers,
            },
          });
        }
      },
    }),
    {
      name: 'quiz_storage',
      partialize: (state) =>
        Object.fromEntries(
          Object.entries(state).filter(([key]) => !['activeQuiz'].includes(key)),
        ),
    },
  ),
);
