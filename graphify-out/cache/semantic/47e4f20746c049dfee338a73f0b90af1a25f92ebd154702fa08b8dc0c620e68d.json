{"nodes": [{"id": "api_stats_handler", "label": "Stats API handler (global / player / record_questions)", "file_type": "code", "source_file": "api/stats.ts", "source_location": "L5-L312", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_stats_question_stats_upsert", "label": "question_stats UPSERT (times_asked / times_correct / fastest)", "file_type": "rationale", "source_file": "api/stats.ts", "source_location": "L283-L299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compteurs cumulatifs par question via INSERT ... ON CONFLICT(question_id) DO UPDATE, incremente en batch de 50 en fin de quiz. Choix d'un agregat materialise (contrairement aux scores recalcules) car il n'existe aucune table d'evenements par question. fastest_correct_ms garde le minimum non nul, 0 servant de sentinelle 'jamais renseigne'."}, {"id": "api_stats_question_text_enrichment", "label": "question_stats enrichment with question text", "file_type": "rationale", "source_file": "api/stats.ts", "source_location": "L63-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "question_stats ne stocke que question_id; le texte est resolu par un seul SELECT ... WHERE id IN (?) sur les ids dedupliques des questions les plus dures et les plus faciles, pour eviter le N+1. Les ids orphelins (question supprimee) retombent sur le libelle '(question supprimee)' \u2014 question_stats n'a pas de cascade delete."}, {"id": "api_stats_case_insensitive_nick_lookup", "label": "Case-insensitive nick resolution", "file_type": "rationale", "source_file": "api/stats.ts", "source_location": "L122-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un premier SELECT LOWER(nick) = LOWER(?) LIMIT 1 resout la casse reelle stockee en DB, puis toutes les requetes de scores utilisent ce resolvedNick en egalite exacte. Les requetes de contribution (pending_questions, questions, boxes) utilisent en revanche le nick brut avec LOWER() des deux cotes \u2014 incoherence assumee car ces tables ont leur propre casse d'auteur."}], "edges": [{"source": "api_stats_handler", "target": "api_scores_scores_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "api/stats.ts", "source_location": "L17-L203", "weight": 1.0}, {"source": "api_stats_handler", "target": "api_scores_handler", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "api/stats.ts", "source_location": null, "weight": 1.0}, {"source": "api_stats_question_stats_upsert", "target": "api_stats_handler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "api/stats.ts", "source_location": "L283-L299", "weight": 1.0}, {"source": "api_stats_question_text_enrichment", "target": "api_stats_handler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "api/stats.ts", "source_location": "L63-L79", "weight": 1.0}, {"source": "api_stats_case_insensitive_nick_lookup", "target": "api_stats_handler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "api/stats.ts", "source_location": "L122-L127", "weight": 1.0}, {"source": "api_stats_question_text_enrichment", "target": "api_stats_question_stats_upsert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "api/stats.ts", "source_location": "L44-L79", "weight": 1.0}, {"source": "api_stats_question_stats_upsert", "target": "services_answer_validator_verifyanswer", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "api/stats.ts", "source_location": "L272-L299", "weight": 1.0}, {"source": "api_scores_batch_insert", "target": "api_stats_question_stats_upsert", "relation": "semantically_similar_to", "c